<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+) cloud and device-transfer policy. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="reader_prefs.xml" />
        <include domain="sharedpref" path="epub_reader_settings.xml" />
        <include domain="sharedpref" path="epub_reader_bookmarks.xml" />
        <include domain="sharedpref" path="reader_slider_chrome_prefs.xml" />
        <include domain="sharedpref" path="listen_sleep_timer_preferences.xml" />
        <include domain="sharedpref" path="annotation_settings_global.xml" />

        <!-- database domain includes Room's -wal/-shm/-journal companions. -->
        <include domain="database" path="reader_database" />

        <include domain="file" path="annotations" />
        <include domain="file" path="page_layouts" />
        <include domain="file" path="textboxes" />
        <include domain="file" path="pdf_highlights" />
        <include domain="file" path="custom_fonts" />
        <include domain="file" path="reader_textures" />

        <exclude domain="sharedpref" path="ai_byok_prefs.xml" />
        <exclude domain="sharedpref" path="reader_opds_prefs.xml" />
        <exclude domain="sharedpref" path="reader_user_prefs.xml" />
        <exclude domain="database" path="book_cache_database" />
        <exclude domain="database" path="pdf_text_cache_db" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="file" path="books" />
        <exclude domain="file" path="audiobooks" />
        <exclude domain="file" path="metadata_backups" />
        <exclude domain="file" path="cover_cache" />
        <exclude domain="file" path="TTS_Cache" />
        <exclude domain="file" path="derived" />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="reader_prefs.xml" />
        <include domain="sharedpref" path="epub_reader_settings.xml" />
        <include domain="sharedpref" path="epub_reader_bookmarks.xml" />
        <include domain="sharedpref" path="reader_slider_chrome_prefs.xml" />
        <include domain="sharedpref" path="listen_sleep_timer_preferences.xml" />
        <include domain="sharedpref" path="annotation_settings_global.xml" />

        <!-- database domain includes Room's -wal/-shm/-journal companions. -->
        <include domain="database" path="reader_database" />

        <include domain="file" path="annotations" />
        <include domain="file" path="page_layouts" />
        <include domain="file" path="textboxes" />
        <include domain="file" path="pdf_highlights" />
        <include domain="file" path="custom_fonts" />
        <include domain="file" path="reader_textures" />
        <include domain="file" path="books" />
        <include domain="file" path="audiobooks" />
        <include domain="file" path="metadata_backups" />

        <exclude domain="sharedpref" path="ai_byok_prefs.xml" />
        <exclude domain="sharedpref" path="reader_opds_prefs.xml" />
        <exclude domain="sharedpref" path="reader_user_prefs.xml" />
        <exclude domain="database" path="book_cache_database" />
        <exclude domain="database" path="pdf_text_cache_db" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="file" path="cover_cache" />
        <exclude domain="file" path="TTS_Cache" />
        <exclude domain="file" path="derived" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
